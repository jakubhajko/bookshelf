# Copy to .env and adjust. .env is gitignored; this file is the only one
# tracked. Mirrors apps/api/src/book_app/core/config.py's Settings exactly —
# add new variables to both when Settings grows in a later phase.
#
# Read by: apps/api (all variables) and apps/web (VITE_-prefixed only, via
# vite.config.ts's envDir pointing at the repo root instead of apps/web/).

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Matches `make db-start`'s project-local Postgres cluster (port 5434) by
# default. Using Docker Compose instead? docker-compose.yml overrides this
# to point at the `db` service — you don't need to change it for that case.
DATABASE_URL=postgresql+psycopg://book_app:book_app@localhost:5434/book_app
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10

# --- JWT / sessions (Phase 3) ---
# Any non-default value works locally. In production a missing/default value
# fails startup — see Settings._reject_insecure_production_defaults.
JWT_SECRET_KEY=dev-insecure-change-me-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Cookies (Phase 3) ---
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# --- CORS --- (JSON array; Vite's dev server default is localhost:5173)
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- CSRF (Phase 3) --- session-bound, random-token-hashed-at-rest (spec
# §8.2's csrf_token_hash column) — no separate secret key needed, see
# core/config.py.

# --- Auth rate limiting (Phase 3); pluggable, in-process default (spec §14) ---
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- Cover storage (Phase 2) ---
COVER_STORAGE_BACKEND=local
COVER_STORAGE_LOCAL_PATH=data/processed/covers
# COVER_STORAGE_S3_BUCKET=

# --- Artifact storage (behavior lands in Phase 5) ---
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_LOCAL_PATH=data/artifacts
# ARTIFACT_STORAGE_S3_BUCKET=

# --- Recommendation provider (behavior lands in Phase 5) ---
RECOMMENDATION_PROVIDER=mock

# --- Demo (behavior lands in Phase 4/9); must be false in production ---
DEMO_MODE_ENABLED=false

# --- Frontend (Vite; must be prefixed VITE_ to reach the browser bundle) ---
VITE_API_BASE_URL=http://localhost:8000

# --- Docker Compose only (db service credentials + POSTGRES_* passthrough) ---
DB_USER=book_app
DB_PASSWORD=book_app
DB_NAME=book_app
