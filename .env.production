# Production build values for apps/web (Vite loads this automatically when
# building in production mode; envDir is the repo root, see vite.config.ts).
#
# Tracked in git on purpose — nothing here is secret.

# Empty = same-origin. The deployed frontend calls /api/v1/... on its own
# Cloudflare Pages domain, and apps/web/functions/api/[[path]].ts proxies
# those to Cloud Run. That keeps the session cookies FIRST-PARTY, which is
# what makes login work in Safari and on iOS (both block third-party cookies
# outright). Pointing this at the Cloud Run URL directly would reintroduce
# exactly that bug.
VITE_API_BASE_URL=
